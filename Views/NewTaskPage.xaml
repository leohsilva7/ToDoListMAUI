<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ToDoList.ViewModels"
             x:DataType="vm:NewTaskViewModel"
             x:Class="ToDoList.Views.NewTaskPage">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Label Text="Nome" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" />
            <Entry Text="{Binding Nome}" FontSize="16" />
            <VerticalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="Salvar" Command="{Binding AddTaskCommand}" BackgroundColor="Blue" WidthRequest="400"/>
                <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="Gray" />
            </VerticalStackLayout>
        </VerticalStackLayout>

    </ContentPage.Content>
</ContentPage>