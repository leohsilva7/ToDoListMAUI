<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDoList.Views.TasksPage"
             xmlns:vm="clr-namespace:ToDoList.ViewModels"
             xmlns:models="clr-namespace:ToDoList.Models"
             x:DataType="vm:TaskViewModel">
    <Grid RowDefinitions="Auto, *" Padding="15">
        <Label Text="Lista de Tarefas" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,15"
               Grid.Row="0" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Tasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Tarefa">
                    <Border Margin="0,5" Padding="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsConcluded}" />
                            <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                            <Button Text="X" Grid.Column="2" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskViewModel}}, Path=RemoveTaskCommand}" CommandParameter="{Binding .}"/>
                            <Button Grid.Column="3" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskViewModel}}, Path=NavigateEditTaskCommand}" CommandParameter="{Binding .}" Text="Editar"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="+" Command="{Binding NavigateNewTaskCommand}" Grid.Row="1" VerticalOptions="End" HorizontalOptions="End" FontAttributes="Bold" Margin="10"
                HeightRequest="100" WidthRequest="100" CornerRadius="50" />
    </Grid>
</ContentPage>